# Copy to .env and adjust. All of these have working defaults for local dev.

PORT=8000

# Where the YOLO inference microservice (../yolo-service) is running.
# This Node service never loads YOLO itself -- it forwards photos there and
# gets back structured detections. See docs/ARCHITECTURE.md Section 8.
YOLO_SERVICE_URL=http://localhost:8001

# Ollama (self-hosted Llama) -- used for report narrative generation.
# Run `ollama serve` and `ollama pull llama3.1:8b` to make this real;
# if unreachable, /report still responds with a clearly-labeled
# placeholder narrative so the rest of the UI keeps working.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60

# SQLite DB file for the Parts Rate table and the corrections/retraining queue.
DATABASE_FILE=./ai_damage_assessment.db

# Where uploaded inspection photos are cached (paired with corrections later).
UPLOAD_DIR=./uploads

# Origins allowed to call this API (the Vite dev server + built web app).
# car-damage-insurance-web-app/vite.config.js sets `https: true`, so the
# dev server's actual origin is https://localhost:5173 (self-signed cert,
# your browser will warn once) -- both http/https variants are listed here
# since which one's active depends on that config staying as-is.
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:4173,https://localhost:4173

# Correction-volume threshold that flags "ready to retrain" (see
# docs/ARCHITECTURE.md Section 6, retraining loop).
RETRAIN_VOLUME_THRESHOLD=5000

# Used by the "Start Training" button (Annotation Studio) to spawn
# training/scripts/prepare_dataset.py + train.py. Points at the venv from
# training/README.md's setup step by default; override if yours lives
# elsewhere. This is a SEPARATE Python env from yolo-service/.venv -- see
# training/requirements.txt.
# TRAINING_PYTHON=../.venv-training/Scripts/python.exe
