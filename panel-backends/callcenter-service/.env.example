# Copy to .env and adjust. Every value has a working default for local dev
# except ADMIN_SERVICE_KEY (without it nobody can sign in).

PORT=8050

# HMAC secret of this portal's session tokens and signed file links.
JWT_SECRET=dev-only-change-me-before-deploying
JWT_EXPIRES_IN_SECONDS=28800

DATABASE_FILE=./callcenter.db
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190,http://localhost:4190

# admin-service: users sign in with their Admin > Create Users account and
# every submitted claim is pushed to the Admin portal (/claims/ingest).
ADMIN_SERVICE_URL=http://127.0.0.1:8040
# Must equal CLAIMS_INGEST_KEY in admin-service/.env.
ADMIN_SERVICE_KEY=
# Seconds a user's status / role / permissions are reused before re-checking with admin-service.
USER_CACHE_SECONDS=30

# Documents DMS files (back this folder up together with callcenter.db).
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=10
FILE_LINK_TTL_SECONDS=3600

# Survey link sent from the Intimation screen (?token= is appended).
SURVEY_LINK_BASE=https://survey.ibimaassist.online/s

# SMS / Email / WhatsApp gateway: each message is POSTed here as JSON
# { channel, to, subject, message, claimNo, reference }. Empty = messages are
# only logged (status Pending), nothing is delivered.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# AI ILA backend (ai-training-backend/server). Empty = "AI not connected";
# reviewers add damaged parts by hand.
AI_SERVICE_URL=

# Hours an open claim may take before the header shows SLA risk.
SLA_HOURS=48
