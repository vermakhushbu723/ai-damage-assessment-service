# Copy to .env and adjust. Every value has a working default for local dev.

PORT=8030

# HMAC secret that signs super admin login tokens (src/utils/jwt.js).
# Use a long random value in production -- anyone holding it can forge a login.
# Deliberately NOT shared with ../auth-service: super admin tokens and field
# portal tokens must never be interchangeable.
JWT_SECRET=dev-only-change-me-before-deploying

# How long a super admin stays signed in (seconds). 8h by default.
JWT_EXPIRES_IN_SECONDS=28800

# SQLite file for this service only.
DATABASE_FILE=./superadmin.db

# Browser origins allowed to call the API. In production the console calls the
# API on its own domain (nginx proxies /api), so CORS only matters for local dev.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:4180

# Where "Send Link" (Password Reset) points users. {token} is appended as ?token=.
RESET_LINK_BASE=http://localhost:5180/reset-password
RESET_LINK_TTL_HOURS=24

# The first three super admin logins, created once on first start if missing
# (never overwritten afterwards -- change passwords from the console/API).
# Leave a password empty and a random one is generated and printed once.
BOOTSTRAP_MASTER_EMAIL=superadmin@ibima.com
BOOTSTRAP_MASTER_PASSWORD=
BOOTSTRAP_SAAS_EMAIL=saas.admin@ibima.com
BOOTSTRAP_SAAS_PASSWORD=
BOOTSTRAP_SP_EMAIL=sp.admin@ibima.com
BOOTSTRAP_SP_PASSWORD=

# Shared secret the claim systems send as X-Service-Key to POST /api/v1/claims/ingest.
# Empty = only the master Super Admin can push claims.
CLAIMS_INGEST_KEY=

# System Settings > System Update card.
APP_VERSION=v2.4.1
LATEST_VERSION=v2.4.1
LATEST_RELEASE_DATE=
