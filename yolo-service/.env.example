# Copy to .env and adjust. All of these have working defaults for local dev.

PORT=8001

# Per-vehicle-type YOLOv8-seg checkpoints. Point these at your fine-tuned
# weights once you have them (e.g. runs/segment/car_v3/weights/best.pt).
# Until then, they default to the stock COCO-pretrained checkpoint below,
# which the API will clearly flag as a placeholder in every response.
# yolov8n-seg.pt (nano) for live serving -- fastest response, CPU-friendly,
# good enough to prove the pipeline end to end while accuracy is still
# placeholder-level (pretrained on COCO, not on real damage photos yet).
# Switch to yolov8s-seg.pt/yolov8m-seg.pt (or your own fine-tuned best.pt)
# once you have a trained checkpoint and want better accuracy over speed.
YOLO_CAR_WEIGHTS=yolov8n-seg.pt
YOLO_TWO_WHEELER_WEIGHTS=yolov8n-seg.pt
YOLO_CV_WEIGHTS=yolov8n-seg.pt

# Confidence threshold for keeping a detection.
YOLO_CONF_THRESHOLD=0.25
