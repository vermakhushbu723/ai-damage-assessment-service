# Copy to .env and adjust. All of these have working defaults for local dev.

PORT=8001

# Per-vehicle-type YOLO11-seg checkpoints. Point these at your fine-tuned
# weights once you have them (e.g. runs/segment/car_v3/weights/best.pt).
# Until then, they default to the stock COCO-pretrained checkpoint below,
# which the API will clearly flag as a placeholder in every response.
YOLO_CAR_WEIGHTS=yolo11l-seg.pt
YOLO_TWO_WHEELER_WEIGHTS=yolo11l-seg.pt
YOLO_CV_WEIGHTS=yolo11l-seg.pt

# Confidence threshold for keeping a detection.
YOLO_CONF_THRESHOLD=0.25
