# Copy to .env and adjust. All of these have working defaults for local dev.

PORT=8020

# MUST be the exact same value as ../auth-service/.env's JWT_SECRET --
# claims-service verifies the tokens auth-service issues, it doesn't issue
# its own (see src/utils/jwt.js -- a trimmed, verify-only copy of
# auth-service's). If these two don't match, every request here 401s with
# "Invalid token" even though the user is genuinely logged in.
JWT_SECRET=dev-only-change-me-before-deploying

# SQLite DB file -- one `claims` table, separate from both ../server's and
# ../auth-service's own DB files.
DATABASE_FILE=./claims.db

# Origins allowed to call this API. Same convention as ../server/.env and
# ../auth-service/.env.
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:4173,https://localhost:4173
