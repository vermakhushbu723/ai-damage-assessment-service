# Copy to .env and adjust. All of these have working defaults for local dev.

PORT=8010

# HMAC secret used to sign/verify login tokens (see src/utils/jwt.js -- a
# small hand-rolled HS256 signer, no external JWT library needed).
# CHANGE THIS before deploying anywhere real -- anyone with this value can
# forge a valid login token for any role/user.
JWT_SECRET=dev-only-change-me-before-deploying

# How long a login stays valid before the user has to sign in again.
JWT_EXPIRES_IN_SECONDS=43200

# SQLite DB file -- one `users` table, one row per portal login. Kept as its
# own file (not shared with ../server/ai_damage_assessment.db) since this is
# a separate service with a separate concern (who's logging in, not AI
# results).
DATABASE_FILE=./auth.db

# Origins allowed to call this API. Same convention as ../server/.env --
# car-damage-insurance-web-app/vite.config.js sets `https: true`, so the
# dev server's actual origin is https://localhost:5173 (both http/https
# variants listed since which one's active depends on that config staying
# as-is). Set to * to allow any origin (dev-only).
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:4173,https://localhost:4173
