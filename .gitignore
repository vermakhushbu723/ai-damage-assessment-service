# AI / training backend: Node API (ai-training-backend/server/)
ai-training-backend/server/node_modules/
ai-training-backend/server/.env
ai-training-backend/server/*.db
ai-training-backend/server/*.db-shm
ai-training-backend/server/*.db-wal
ai-training-backend/server/uploads/

# Python YOLO microservice (ai-training-backend/yolo-service/) and ai-training-backend/training/
ai-training-backend/yolo-service/.venv/
ai-training-backend/yolo-service/__pycache__/
ai-training-backend/yolo-service/.env
ai-training-backend/yolo-service/uvicorn*.log
ai-training-backend/yolo-service/uvicorn.pid
ai-training-backend/training/.venv/
ai-training-backend/training/__pycache__/
ai-training-backend/training/data/*/.data.resolved.yaml
ai-training-backend/training/runs/
ai-training-backend/training/raw_pool/
ai-training-backend/training/data/*/labels/*.cache
*.pt

# Training venv created per training/README.md ("python -m venv .venv-training"
# in ai-training-backend/) -- separate from yolo-service/.venv, holds torch +
# ultralytics (large, machine-specific, never commit).
.venv-training/

# Panel backends (panel-backends/*) keep their own .gitignore (.env, *.db, uploads/).

# Anything else Python/Node leave lying around
__pycache__/
*.pyc
node_modules/
.DS_Store
Thumbs.db

# Label Studio (annotation tool) venv + its local DB/media
.venv-labelstudio/
.labelstudio-data/
