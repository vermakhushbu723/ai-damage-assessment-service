# Copy to .env and adjust. Every value has a working default for local dev.

PORT=8040

# HMAC secret that signs Admin portal login tokens (src/utils/jwt.js).
# Use a long random value in production -- anyone holding it can forge a login.
# Deliberately NOT shared with ../superadmin-service or ../auth-service.
JWT_SECRET=dev-only-change-me-before-deploying

# How long an admin stays signed in (seconds). 8h by default.
JWT_EXPIRES_IN_SECONDS=28800

# SQLite file for this service only.
DATABASE_FILE=./admin.db

# Browser origins allowed to call the API. In production the portal calls the
# API on its own domain (nginx proxies /api), so CORS only matters for local dev.
CORS_ORIGINS=http://localhost:5200,http://127.0.0.1:5200,http://localhost:4200

# The insurer this portal belongs to: "Internal" users get it as organization,
# and branches of other organizations count as Service Provider in Claim Report.
ORGANIZATION_NAME=ABG Insurance

# Where Password Reset "Send Link" points users. ?token= is appended.
RESET_LINK_BASE=http://localhost:5200/reset-password
RESET_LINK_TTL_HOURS=24

# The admin login, created once on first start if no admin exists
# (never overwritten afterwards). Leave the password empty and a random one
# is generated and printed once in the log.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@ibima.com
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_ADMIN_PASSWORD=

# Shared secret the claim systems send as X-Service-Key to POST /api/v1/claims/ingest.
# Empty = only a signed-in admin can push claims.
CLAIMS_INGEST_KEY=

# System Settings > System Update card.
PRODUCT_NAME=IBima Assist Enterprise
ENVIRONMENT_NAME=Production Environment
APP_VERSION=2.4.1
LATEST_VERSION=2.4.1
LATEST_RELEASE_DATE=
