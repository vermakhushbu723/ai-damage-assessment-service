# Copy to .env and adjust. All of these have working defaults for local dev.

PORT=8001

# Per-vehicle-type checkpoints. Point these at your own fine-tuned weights
# once you have them (e.g. ../training/runs/segment/car_v3/weights/best.pt).
# Until then, they default to "cardd-seg.pt" -- a real, published,
# damage-specific checkpoint (auto-downloaded on first request, ~120MB, see
# app.py's module docstring), NOT a generic COCO-pretrained model -- it
# already detects 6 real damage types (crack, dent, glass_shatter,
# lamp_broken, scratch, tire_flat) out of the box, before you've annotated
# or trained anything. `is_placeholder_model` still comes back true until
# you point this at your own fine-tune, since it isn't trained on *your*
# cars/photos and doesn't assign a part (bumper/door/etc.) yet.
YOLO_CAR_WEIGHTS=cardd-seg.pt
YOLO_TWO_WHEELER_WEIGHTS=cardd-seg.pt
YOLO_CV_WEIGHTS=cardd-seg.pt

# Confidence threshold for keeping a detection.
YOLO_CONF_THRESHOLD=0.25
